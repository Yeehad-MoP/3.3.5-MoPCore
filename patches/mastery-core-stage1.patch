+
+void Player::ApplyMasteryRatingBonus(int32 amount, bool apply)
+{
+    m_masteryRating += apply ? amount : -amount;
+
+    // Defensive clamp for malformed item data or repeated remove calls.
+    if (m_masteryRating < 0)
+        m_masteryRating = 0;
+
+    UpdateMastery();
+}
+
+float Player::GetMasteryRatingBonusValue() const
+{
+    uint8 level = GetLevel();
+    if (level > GT_MAX_LEVEL)
+        level = GT_MAX_LEVEL;
+
+    // MoP places Mastery at combat-rating block 25. We intentionally do not
+    // add it to the WotLK CombatRating enum / update-field array.
+    constexpr uint32 MasteryRatingIndex = 25;
+
+    GtCombatRatingsEntry const* rating = sGtCombatRatingsStore.LookupEntry(MasteryRatingIndex * GT_MAX_LEVEL + level - 1);
+    GtOCTClassCombatRatingScalarEntry const* classRating =
+        sGtOCTClassCombatRatingScalarStore.LookupEntry((getClass() - 1) * GT_MAX_RATING + MasteryRatingIndex + 1);
+
+    if (!rating || !classRating || rating->ratio <= 0.0f)
+        return 0.0f;
+
+    return float(m_masteryRating) * classRating->ratio / rating->ratio;
+}
+
+void Player::UpdateMastery()
+{
+    // Cataclysm/MoP Mastery starts at 8 base points. Additional Mastery comes
+    // from the MoP gtCombatRatings block 25 and the existing class scalar DBC.
+    m_mastery = 8.0f + GetMasteryRatingBonusValue();
+}
