diff --git a/src/server/game/Entities/Unit/StatSystem.cpp b/src/server/game/Entities/Unit/StatSystem.cpp
--- a/src/server/game/Entities/Unit/StatSystem.cpp
+++ b/src/server/game/Entities/Unit/StatSystem.cpp
@@
 bool Player::UpdateAllStats()
 {
@@
     UpdateAllRatings();
+    UpdateMastery();
     UpdateAllCritPercentages();
@@
     return true;
 }
+
+void Player::ApplyMasteryRatingBonus(int32 amount, bool apply)
+{
+    m_masteryRating += apply ? amount : -amount;
+
+    // Defensive clamp for malformed item data / repeated remove calls.
+    if (m_masteryRating < 0)
+        m_masteryRating = 0;
+
+    UpdateMastery();
+}
+
+void Player::UpdateMastery()
+{
+    // MoP characters have 8 base Mastery points. Rating conversion is kept
+    // separate from WotLK combat-rating update fields and will be wired to the
+    // MoP rating table in the next stage.
+    m_mastery = 8.0f;
+}
